{
  "name": "ticket-check-bro",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "description": "Intelligent Document Intelligence Platform — parse invoices, receipts, and financial documents in-browser. Upload PDFs & images, extract structured fields, export to spreadsheet. Zero-server, fully client-side.",
  "keywords": [
    "document-parsing",
    "invoice-ocr",
    "pdf-extraction",
    "receipt-scanner",
    "spreadsheet-export",
    "browser-tool",
    "react",
    "vite"
  ],
  "author": "bo-wu-feng-199",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bo-wu-feng-199/Ticket-Check-Bro.git"
  },
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"*.{json,md,cjs}\"",
    "evolve": "node scripts/evolve.mjs",
    "build:core": "cd packages/core && echo 'No build step needed — package is pure ESM'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.14",
    "vitest": "^4.1.10"
  }
}
